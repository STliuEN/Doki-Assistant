# ==============================================
# 运行环境与浏览器边界
# ==============================================
# dev/development | test/testing | prod/production；其他值拒绝启动。
# prod/production 会对 DEBUG、密钥、CORS 和认证状态校验 fail fast。
ENV=dev
# Development may use true; production requires an explicit false value.
DEBUG_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================
# LLM 大模型配置
# ==============================================
# LLM类型：ALIYUN(阿里云百炼) | OLLAMA(本地模型)
LLM_TYPE=ALIYUN

# ==============================================
# Ollama 配置（仅 LLM_TYPE=OLLAMA 时生效）
# ==============================================
# Ollama 服务地址（本地运行Ollama时，默认为该地址）
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 聊天模型（需提前 ollama pull 下载）
OLLAMA_MODEL_NAME=qwen3:0.6b

# ==============================================
# 阿里云百炼配置（仅 LLM_TYPE=ALIYUN 时生效），可能产生费用，注意控制用量
# ==============================================
# 阿里云 API Key（格式：sk-xxxx）
# 申请地址：https://dashscope.console.aliyun.com/
ALIYUN_ACCESS_KEY_SECRET=your_api_key
# 阿里云 API 地址
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云聊天模型名称
CHAT_MODEL_NAME=qwen3-max

# ==============================================
# 向量嵌入模型配置
# ==============================================
# 嵌入模型类型：OLLAMA | ALIYUN
EMBED_MODEL_TYPE=OLLAMA
# Ollama 嵌入模型（需提前下载），当EMBED_MODEL_TYPE=OLLAMA时使用
TEXT_EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
# 阿里云嵌入模型（当EMBED_MODEL_TYPE=ALIYUN时使用），需确保阿里云百炼平台有该模型且账户余额充足
ALIYUN_EMBED_MODEL_NAME=qwen3-embedding

# ==============================================
# 多模态视觉模型配置（用于PDF多模态图片描述）
# ==============================================
# 视觉模型类型：ALIYUN | OLLAMA；为空则沿用 LLM_TYPE
VISION_MODEL_TYPE=
# 阿里云视觉模型名称（当VISION_MODEL_TYPE=ALIYUN时使用），建议使用 qwen-vl 系列模型
VISION_CHAT_MODEL_NAME=qwen-vl-max
# Ollama视觉模型名称（当VISION_MODEL_TYPE=OLLAMA时使用），需 ollama pull 下载
VISION_OLLAMA_MODEL_NAME=qwen-vl:7b

# ==============================================
# 视觉模型批处理优化配置（降低API调用次数和延迟）
# ==============================================
# 每批页数：将多页合并到一次视觉API调用（默认5，越大越省token但描述粒度可能下降）
VISION_BATCH_SIZE=5
# 是否启用感知哈希去重：相似页面只描述一次，结果共享（对PPT/模板类PDF效果显著）
VISION_DEDUP_ENABLED=true
# 感知哈希距离阈值（0-64，越小越严格）：两页哈希距离≤此值视为相似
VISION_DEDUP_THRESHOLD=10
# 批量处理时使用1x低分辨率代替2x（节省token和传输体积）
VISION_BATCH_LOW_RES=true

# ==============================================
# 重排序模型配置
# ==============================================
# 重排序模型本地路径；本地目录完整时不会重新下载
RERANKER_MODEL_PATH=./models/qwen3-reranker-4b
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-4B
RERANKER_MODEL_REVISION=master
RERANKER_DEVICE=auto
RERANKER_MAX_LENGTH=8192
RERANKER_BATCH_SIZE=1
RERANKER_TORCH_DTYPE=auto
RERANKER_MIN_WEIGHT_MB=50
RERANKER_TRUST_REMOTE_CODE=false

# ==============================================
# 数据库配置
# ==============================================
# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=chat_history

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=18020
REDIS_DB=0
# JWT 撤销与 Django RedisCache 使用独立 DB，默认与用户服务的 /1 对齐。
JWT_REDIS_URL=redis://localhost:18020/1

# ==============================================
# 限流配置
# ==============================================
# 全局限流开关：设为 false 可禁用所有路由上的 rate_limit 依赖
# 开发调试阶段建议设为 false，生产环境建议设为 true 并配合具体阈值
RATE_LIMIT_ENABLED=false
GLOBAL_RATE_LIMIT_REQUESTS=300
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60

# Django API 地址，用户服务地址，用于调用用户服务的API
DJANGO_API_URL=http://127.0.0.1:18001
DJANGO_API_TIMEOUT_SECONDS=5
AUTH_STATE_VALIDATION_ENABLED=true
AUTH_STATE_CACHE_SECONDS=15

# LangSmith 调试追踪（默认关闭；显式启用后才会向外部发送追踪数据）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=my-fastapi-langchain-project

# ==============================================
# JWT 身份验证配置
# ==============================================
# 必填：需与 Django 用户服务签发 JWT 时使用的密钥一致
SECRET_KEY=replace-with-shared-django-jwt-secret
ALGORITHM=HS256
JWT_ISSUER=doki-user-service
JWT_AUDIENCE=doki-api
JWT_BLACKLIST_KEY_PREFIX=blacklist
# Django RedisCache 默认 VERSION=1，因此 FastAPI 同时检查 :1:blacklist:<jti>。
DJANGO_CACHE_VERSION=1

# ==============================================
# 模型配置加密与管理员配置
# ==============================================
# 已有密文升级时，首次配置必须先使用当前 SECRET_KEY 的相同值。
# 分离密钥前请运行 backend/scripts/rotate_model_config_keys.py。
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-model-config-encryption-key
# 仅在轮换模型配置加密密钥时临时设置，迁移完成后删除。
MODEL_CONFIG_ENCRYPTION_KEY_PREVIOUS=

# 逗号分隔；也可以通过 security.local.yaml 配置。
ADMIN_USER_IDS=
ADMIN_USERNAMES=

# 可选：覆盖默认的本机配置路径。
SECURITY_CONFIG_PATH=
MCP_CONFIG_PATH=
