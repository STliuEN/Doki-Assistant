{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doki Benchmark Case",
  "type": "object",
  "required": ["id", "suite", "title", "mode", "input", "fixtures", "expect", "tags"],
  "properties": {
    "id": { "type": "string" },
    "suite": { "type": "string" },
    "title": { "type": "string" },
    "mode": { "enum": ["offline", "integration", "online"] },
    "variant": { "enum": ["manual", "auto"] },
    "input": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "model_config_id": { "type": ["string", "null"] },
        "prompt_type": { "type": ["string", "null"] },
        "skill_ids": { "type": ["array", "null"], "items": { "type": "string" } },
        "tool_ids": { "type": ["array", "null"], "items": { "type": "string" } },
        "routed_skill_ids": { "type": ["array", "null"], "items": { "type": "string" } },
        "context": { "type": ["object", "null"] },
        "rag_retrieval": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "object",
      "required": ["model_script"],
      "properties": {
        "model_script": { "type": "string", "minLength": 1 },
        "tool_data": {
          "type": "object",
          "properties": {
            "memories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "type", "status", "priority"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "type": { "type": "string" },
                  "status": { "type": "string" },
                  "priority": { "type": "string" },
                  "content": { "type": ["string", "null"] },
                  "due_at": { "type": ["string", "null"] },
                  "remind_at": { "type": ["string", "null"] },
                  "source_type": { "type": ["string", "null"] },
                  "source_id": { "type": ["string", "null"] },
                  "review_count": { "type": ["integer", "null"] },
                  "interval_days": { "type": ["integer", "null"] }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": false
        },
        "routing": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["scripted", "production"] }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "properties": {
            "cross_user_accesses": { "type": "array", "items": { "type": "string" } },
            "external_accesses": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "properties": {
        "must_include": { "type": "array", "items": { "type": "string" } },
        "must_not_include": { "type": "array", "items": { "type": "string" } },
        "tool_policy": {
          "type": "object",
          "properties": {
            "allowed": { "type": "array", "items": { "type": "string" } },
            "forbidden_call": { "type": "array", "items": { "type": "string" } },
            "forbidden_execute": { "type": "array", "items": { "type": "string" } },
            "expect_blocked": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "event_contract": {
          "type": "object",
          "properties": {
            "first_event_type": { "type": "string" },
            "require_done_session_id": { "type": "boolean" },
            "require_response_before_done": { "type": "boolean" },
            "require_non_empty_response_before_done": { "type": "boolean" },
            "ordered_types": { "type": "array", "items": { "type": "string" } },
            "exactly_once": { "type": "array", "items": { "type": "string" } },
            "forbidden_types": { "type": "array", "items": { "type": "string" } },
            "terminal_type": { "type": "string" }
          },
          "additionalProperties": false
        },
        "routing_contract": {
          "type": "object",
          "properties": {
            "exact_skill_ids": { "type": "array", "items": { "type": "string" } },
            "allowed_skill_ids": { "type": "array", "items": { "type": "string" } },
            "forbidden_skill_ids": { "type": "array", "items": { "type": "string" } },
            "exact_tool_ids": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "state_contract": {
          "type": "object",
          "properties": {
            "created_messages": { "type": "integer", "minimum": 0 },
            "updated_messages": { "type": "integer", "minimum": 0 },
            "pending_actions": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "efficiency_contract": {
          "type": "object",
          "properties": {
            "min_tool_calls": { "type": "integer", "minimum": 0 },
            "max_tool_calls": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "hard_vetoes": {
          "type": "object",
          "properties": {
            "forbidden_execute": { "type": "array", "items": { "type": "string" } },
            "forbidden_cross_user_access": { "type": "boolean" },
            "forbidden_external_access": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "must_include_score": { "type": "number", "minimum": 0 },
            "forbidden_content_score": { "type": "number", "minimum": 0 },
            "event_contract_score": { "type": "number", "minimum": 0 },
            "tool_policy_score": { "type": "number", "minimum": 0 },
            "stop_reason_score": { "type": "number", "minimum": 0 },
            "routing_contract_score": { "type": "number", "minimum": 0 },
            "state_contract_score": { "type": "number", "minimum": 0 },
            "efficiency_score": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "stop_reason": { "type": "string" },
        "min_score": { "type": "number" }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
