      },
      {
        "id": "async-path",
        "label": "可靠异步链路",
        "focus": ["api", "outbox", "worker", "storage", "chroma"],
        "note": "API 事务内记录任务，独立 Worker 可重试地从源文件生成版本化向量投影。"
      },
      {
        "id": "migration-boundary",
        "label": "迁移与外部边界",
        "focus": ["django", "worker", "model"],
        "note": "Django 仅保留迁移兼容路径；模型、Embedding 和 MCP 通过受控依赖边界访问。"
      }
    ]
